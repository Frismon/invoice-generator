# Copy to .env (repo root). Never commit .env.

# API server
HOST=127.0.0.1
PORT=3001
# Default: server/data/invoices.db
DATABASE_PATH=
# Only needed if the frontend is served from a different origin than the API
CORS_ORIGIN=http://localhost:5173

# Email (any SMTP provider). Leave SMTP_HOST empty to log emails instead of sending.
# Examples:
#   Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<api key>
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char App Password>
#             MAIL_FROM must be the same Gmail address. App Passwords: https://myaccount.google.com/apppasswords
#   Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  SMTP_USER=<user>  SMTP_PASS=<pass>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender your provider allows (e.g. a verified domain)
MAIL_FROM="Invoices <invoices@your-verified-domain.com>"
