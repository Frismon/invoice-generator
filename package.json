{
  "name": "invoice-generator",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
